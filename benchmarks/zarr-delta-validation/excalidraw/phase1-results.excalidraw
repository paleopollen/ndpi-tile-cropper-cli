  },
  {
   "type": "text",
   "fontFamily": 9,
   "verticalAlign": "top",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "containerId": null,
   "lineHeight": 1.25,
   "id": "note_0",
   "x": 50,
   "y": 900,
   "width": 1270,
   "height": 18,
   "text": "\u00b9 Blosc-zstd-3 compresses tiles less than PNG does, as our October benchmark predicted; a stronger codec can close the gap.",
   "originalText": "\u00b9 Blosc-zstd-3 compresses tiles less than PNG does, as our October benchmark predicted; a stronger codec can close the gap.",
   "fontSize": 14,
   "strokeColor": "#64748b",
   "textAlign": "left",
   "seed": 557139845
  },
  {
   "type": "text",
   "fontFamily": 9,
   "verticalAlign": "top",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "containerId": null,
   "lineHeight": 1.25,
   "id": "note_1",
   "x": 50,
   "y": 924,
   "width": 1270,
   "height": 18,
   "text": "\u00b2 TADP's PNG crop wrote planes 4\u00d7 slower than PAL's (likely Taiga small-file load); PAL's 3.2\u00d7 is the typical gain.",
   "originalText": "\u00b2 TADP's PNG crop wrote planes 4\u00d7 slower than PAL's (likely Taiga small-file load); PAL's 3.2\u00d7 is the typical gain.",
   "fontSize": 14,
   "strokeColor": "#64748b",
   "textAlign": "left",
   "seed": 593876045
  },
  {
   "type": "text",
   "fontFamily": 9,
   "verticalAlign": "top",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "containerId": null,
   "lineHeight": 1.25,
   "id": "note_2",
   "x": 50,
   "y": 948,
   "width": 1270,
   "height": 18,
   "text": "\u00b3 SAM 2 takes the same time in both; Zarr saves writing MIP images and one file per segment plane.",
   "originalText": "\u00b3 SAM 2 takes the same time in both; Zarr saves writing MIP images and one file per segment plane.",
   "fontSize": 14,
   "strokeColor": "#64748b",
   "textAlign": "left",
   "seed": 1597283778
  },
  {
   "type": "text",
   "fontFamily": 9,
   "verticalAlign": "top",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "containerId": null,
   "lineHeight": 1.25,
   "id": "note_3",
   "x": 50,
   "y": 972,
   "width": 1270,
   "height": 18,
   "text": "\u2074 99.1% of boxes overlap \u2265 50% (91.6% identical) once production's old 5 px box padding is removed.",
   "originalText": "\u2074 99.1% of boxes overlap \u2265 50% (91.6% identical) once production's old 5 px box padding is removed.",
   "fontSize": 14,
   "strokeColor": "#64748b",
   "textAlign": "left",
   "seed": 2074762146
  },
  {
   "type": "text",
   "fontFamily": 9,
   "verticalAlign": "top",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "containerId": null,
   "lineHeight": 1.25,
   "id": "note_4",
   "x": 50,
   "y": 1004,
   "width": 1270,
   "height": 18,
   "text": "GiB = 2\u00b3\u2070 bytes  \u00b7  wall-clock times on Delta  \u00b7  crop times add up resumed jobs  \u00b7  PASS = gated test, exactly equal",
   "originalText": "GiB = 2\u00b3\u2070 bytes  \u00b7  wall-clock times on Delta  \u00b7  crop times add up resumed jobs  \u00b7  PASS = gated test, exactly equal",
